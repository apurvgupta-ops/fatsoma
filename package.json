{
  "name": "fatsoma",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@fatsoma/api",
    "dev:admin": "turbo run dev --filter=@fatsoma/admin",
    "dev:web": "turbo run dev --filter=@fatsoma/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "seed": "turbo run seed --filter=@fatsoma/api"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5"
  }
}
